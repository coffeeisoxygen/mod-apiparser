# =============================================================================
# ENVIRONMENT LOADER
# =============================================================================
# This file determines which environment file to load based on APP_ENV
# Usage:
#   1. Set APP_ENV environment variable to: development, production, or testing
#   2. Create corresponding .env.{environment} files
#   3. This will load the appropriate configuration

# Default to development if no APP_ENV is set
APP_ENV=development

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# When APP_ENV=development, these values will be used as fallback
# Override with .env.dev file

APP_DEBUG=true
APP_SERVICE=mod-apiparser
APP_VERSION=0.1.0

SECURITY_SECRET_KEY=dev-fallback-secret-key
SECURITY_ALGORITHM=HS256

JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev-fallback-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
JWT_ISSUER=otomax-api-dev
JWT_AUDIENCE=otomax-client-dev

# Development paths
PATH_USERS=secrets/dev_users.yaml
PATH_MODULES=secrets/dev_modules.yaml
PATH_KEYS=secrets/keys

# Relaxed security for development
JWT_VERIFY_AUDIENCE=false
JWT_VERIFY_ISSUER=false
JWT_BLACKLIST_ENABLED=false
JWT_REQUIRE_HTTPS=false
JWT_COOKIE_SECURE=false
